{
  "name": "gamebook",
  "private": true,
  "version": "0.5.3",
  "description": "A native in-game screenshot annotation and field-notes overlay.",
  "type": "module",
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "tauri dev",
    "build": "tauri build",
    "frontend:dev": "vite",
    "frontend:build": "tsc && vite build",
    "frontend:test": "vitest run",
    "frontend:test:watch": "vitest",
    "fixtures:generate": "node tools/fixtures/generate-fixtures.mjs --write",
    "fixtures:verify": "node tools/fixtures/generate-fixtures.mjs --verify",
    "native-capture:fixture:verify": "node tools/spikes/verify-native-capture-fixture.mjs",
    "native-capture:verify": "node tools/spikes/verify-native-capture-report.mjs",
    "wasapi-sync:verify": "node tools/spikes/verify-wasapi-av-sync-report.mjs",
    "native-decode:verify": "node tools/spikes/verify-native-decode-report.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.8.0",
    "fabric": "^7.4.0",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.12.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
